<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Xiaomuocr.Core.Models;assembly=Xiaomuocr.Core"
             xmlns:vm="clr-namespace:Xiaomuocr.Core.ViewModels;assembly=Xiaomuocr.Core"
             x:Class="Xiaomuocr.Views.Views.FeedbackView"
             x:Name="Root"
             x:DataType="vm:FeedbackViewModel">
    <Grid RowDefinitions="Auto,*" Margin="24,20">
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock Text="联系反馈" FontSize="22" FontWeight="Bold"
                           Foreground="#2D3A2C" VerticalAlignment="Center" />
                <Button Content="刷新" Command="{Binding RefreshCommand}"
                        DockPanel.Dock="Right"
                        Background="#EAE5D9" Foreground="#5C5344"
                        FontSize="12" Padding="12,6" CornerRadius="6"
                        HorizontalAlignment="Right" />
            </DockPanel>
            <Border Background="#F5E0DC" CornerRadius="6" Padding="8,6"
                    IsVisible="{Binding HasError}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#B8443C" FontSize="12"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,*">
            <!-- 公告栏 -->
            <Border Grid.Column="0" Background="#FDFBF7" CornerRadius="10" Padding="16"
                    Margin="0,0,8,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="公告栏" FontSize="16" FontWeight="Bold"
                               Foreground="#2D3A2C" Margin="0,0,0,10" />
                    <TextBlock DockPanel.Dock="Top" Text="暂无公告"
                               IsVisible="{Binding IsAnnouncementsEmpty}"
                               Foreground="#8B8370" FontSize="13" Margin="0,20,0,0"
                               HorizontalAlignment="Center" />
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Announcements}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:AnnouncementItem">
                                    <Border Background="#EAE5D9" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold"
                                                       Foreground="#2D3A2C" FontSize="14"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding PublishedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                                       FontSize="11" Foreground="#8B8370" />
                                            <TextBlock Text="{Binding Content}" FontSize="13"
                                                       Foreground="#5C5344" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 留言板 -->
            <Border Grid.Column="1" Background="#FDFBF7" CornerRadius="10" Padding="16"
                    Margin="8,0,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,10">
                        <TextBlock Text="留言板" FontSize="16" FontWeight="Bold" Foreground="#2D3A2C" />
                        <TextBlock Text="提交与回复均需审核；每日最多 10 条（含回复）；每页最多 20 条"
                                   FontSize="11" Foreground="#8B8370" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="最新发布" Command="{Binding SortNewestCommand}"
                                    FontSize="12" Padding="10,4" CornerRadius="4"
                                    Background="#4A7C59" Foreground="White" />
                            <Button Content="点赞最多" Command="{Binding SortLikesCommand}"
                                    FontSize="12" Padding="10,4" CornerRadius="4"
                                    Background="#EAE5D9" Foreground="#5C5344" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <Button Content="上一页" Command="{Binding PrevPageCommand}"
                                    IsEnabled="{Binding CanPrevPage}"
                                    FontSize="12" Padding="10,4" CornerRadius="4"
                                    Background="#EAE5D9" Foreground="#5C5344" />
                            <TextBlock Text="{Binding PageLabel}" FontSize="12"
                                       Foreground="#5C5344" VerticalAlignment="Center" />
                            <Button Content="下一页" Command="{Binding NextPageCommand}"
                                    IsEnabled="{Binding CanNextPage}"
                                    FontSize="12" Padding="10,4" CornerRadius="4"
                                    Background="#EAE5D9" Foreground="#5C5344" />
                        </StackPanel>
                        <TextBox Text="{Binding NewMessage}" AcceptsReturn="True"
                                 Height="64" TextWrapping="Wrap" MaxLength="1000"
                                 Watermark="写下你的留言..." />
                        <DockPanel>
                            <TextBlock Text="{Binding SubmitMessage}" FontSize="12"
                                       Foreground="#4A7C59" VerticalAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="200" />
                            <Button Content="提交留言" Command="{Binding SubmitCommand}"
                                    DockPanel.Dock="Right"
                                    Background="#4A7C59" Foreground="White"
                                    FontSize="13" Padding="14,7" CornerRadius="6"
                                    HorizontalAlignment="Right" />
                        </DockPanel>
                    </StackPanel>

                    <TextBlock Text="暂无留言"
                               IsVisible="{Binding IsMessagesEmpty}"
                               Foreground="#8B8370" FontSize="13" Margin="0,20,0,0"
                               HorizontalAlignment="Center" />
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BoardMessageCard">
                                    <Border Background="#EAE5D9" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                        <StackPanel Spacing="6">
                                            <DockPanel>
                                                <TextBlock Text="{Binding AuthorDisplay}" FontWeight="SemiBold"
                                                           Foreground="#2D3A2C" FontSize="13" />
                                                <TextBlock Text="{Binding StatusLabel}"
                                                           IsVisible="{Binding ShowStatusBadge}"
                                                           DockPanel.Dock="Right"
                                                           FontSize="11" Foreground="#B8443C"
                                                           HorizontalAlignment="Right" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                                       FontSize="11" Foreground="#8B8370" />
                                            <TextBlock Text="{Binding Content}" FontSize="13"
                                                       Foreground="#5C5344" TextWrapping="Wrap" />

                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="{Binding LikeButtonText}"
                                                        IsVisible="{Binding CanLike}"
                                                        Command="{Binding #Root.((vm:FeedbackViewModel)DataContext).LikeCommand}"
                                                        CommandParameter="{Binding}"
                                                        FontSize="11" Padding="8,3" CornerRadius="4"
                                                        Background="#FDFBF7" Foreground="#4A7C59" />
                                                <Button Content="回复"
                                                        IsVisible="{Binding CanReply}"
                                                        Command="{Binding #Root.((vm:FeedbackViewModel)DataContext).ToggleReplyBoxCommand}"
                                                        CommandParameter="{Binding}"
                                                        FontSize="11" Padding="8,3" CornerRadius="4"
                                                        Background="#FDFBF7" Foreground="#5C5344" />
                                                <Button Content="{Binding MoreRepliesLabel}"
                                                        IsVisible="{Binding ShowMoreReplies}"
                                                        Command="{Binding #Root.((vm:FeedbackViewModel)DataContext).ToggleMoreRepliesCommand}"
                                                        CommandParameter="{Binding}"
                                                        FontSize="11" Padding="8,3" CornerRadius="4"
                                                        Background="Transparent" Foreground="#9B722E" />
                                            </StackPanel>

                                            <!-- 最新一条回复预览 -->
                                            <Border IsVisible="{Binding HasLatestReply}"
                                                    Background="#F5F2EA" CornerRadius="6"
                                                    Padding="8,6" Margin="0,2,0,0">
                                                <StackPanel Spacing="2">
                                                    <TextBlock FontSize="11" Foreground="#8B8370">
                                                        <Run Text="最新回复 · " />
                                                        <Run Text="{Binding LatestReply.AuthorDisplay}" FontWeight="SemiBold" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding LatestReply.Content}" FontSize="12"
                                                               Foreground="#5C5344" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>

                                            <!-- 展开最多 6 条 -->
                                            <ItemsControl ItemsSource="{Binding ExpandedReplies}"
                                                          IsVisible="{Binding RepliesExpanded}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:BoardReplyItem">
                                                        <Border Background="#F5F2EA" CornerRadius="6"
                                                                Padding="8,6" Margin="0,0,0,4">
                                                            <StackPanel Spacing="2">
                                                                <DockPanel>
                                                                    <TextBlock Text="{Binding AuthorDisplay}"
                                                                               FontSize="11" FontWeight="SemiBold"
                                                                               Foreground="#5C5344" />
                                                                    <TextBlock Text="{Binding StatusLabel}"
                                                                               IsVisible="{Binding ShowStatusBadge}"
                                                                               DockPanel.Dock="Right"
                                                                               FontSize="10" Foreground="#B8443C" />
                                                                </DockPanel>
                                                                <TextBlock Text="{Binding Content}" FontSize="12"
                                                                           Foreground="#5C5344" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Border IsVisible="{Binding HasAdminReply}"
                                                    Background="#D4E8DA" CornerRadius="6"
                                                    Padding="10,8" Margin="0,4,0,0">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="管理员答复" FontSize="11" FontWeight="Bold"
                                                               Foreground="#2D5A3D" />
                                                    <TextBlock Text="{Binding AdminReply}" FontSize="13"
                                                               Foreground="#2D3A2C" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>

                                            <StackPanel IsVisible="{Binding ReplyBoxVisible}" Spacing="4">
                                                <TextBox Text="{Binding ReplyDraft}" AcceptsReturn="True"
                                                         Height="48" TextWrapping="Wrap" MaxLength="1000"
                                                         Watermark="写下回复（需审核）..." />
                                                <Button Content="提交回复"
                                                        Command="{Binding #Root.((vm:FeedbackViewModel)DataContext).SubmitReplyCommand}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Right"
                                                        Background="#4A7C59" Foreground="White"
                                                        FontSize="12" Padding="10,5" CornerRadius="4" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
