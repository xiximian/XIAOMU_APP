<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Xiaomuocr.Views.Views.ExportFullTextDialog"
        Title="导出全文" Width="420" Height="400"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <Grid RowDefinitions="*,Auto" Margin="16">
        <StackPanel Grid.Row="0" Spacing="14">
            <TextBlock Text="内容模式" FontSize="13" FontWeight="Bold" Foreground="#2D3A2C" />
            <StackPanel Spacing="6" Margin="8,0,0,0">
                <RadioButton Name="ModeOriginal" Content="原文"
                             GroupName="ScriptMode" IsChecked="True"
                             FontSize="13" />
                <RadioButton Name="ModeSimplified" Content="简体"
                             GroupName="ScriptMode"
                             FontSize="13" />
                <CheckBox Name="ApplyPunctuateCheck" Content="句逗处理"
                          FontSize="13" Margin="0,4,0,0"
                          ToolTip.Tip="正文块先自动句逗；标题等非正文不句逗。可与原文或简体叠加。需登录且服务端可用。" />
            </StackPanel>

            <TextBlock Text="导出格式" FontSize="13" FontWeight="Bold" Foreground="#2D3A2C" Margin="0,4,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="8,0,0,0">
                <RadioButton Name="FormatTxt" Content="TXT 文本"
                             GroupName="Format" IsChecked="True" FontSize="13" />
                <RadioButton Name="FormatMd" Content="Markdown"
                             GroupName="Format" FontSize="13" />
            </StackPanel>

            <TextBlock Text="页码范围" FontSize="13" FontWeight="Bold" Foreground="#2D3A2C" Margin="0,4,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                <TextBlock Text="从" VerticalAlignment="Center" FontSize="13" />
                <TextBox Name="PageFromBox" Width="64" FontSize="13" />
                <TextBlock Text="到" VerticalAlignment="Center" FontSize="13" />
                <TextBox Name="PageToBox" Width="64" FontSize="13" />
                <TextBlock Name="PageHint" VerticalAlignment="Center"
                           FontSize="12" Foreground="#8B8370" />
            </StackPanel>

            <TextBlock Name="ErrorLabel" Text="" FontSize="12" Foreground="#B8443C"
                       TextWrapping="Wrap" IsVisible="False" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="8" Margin="0,16,0,0">
            <Button Name="CancelBtn" Content="取消" Padding="16,8" FontSize="13"
                    Background="#EAE5D9" CornerRadius="4" />
            <Button Name="OkBtn" Content="导出" Padding="16,8" FontSize="13"
                    Background="#4A7C59" Foreground="White" CornerRadius="4" />
        </StackPanel>
    </Grid>
</Window>
